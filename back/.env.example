# Postgres (Neon en prod) — base dédiée « todos »
DATABASE_URL=postgresql://user:password@host/todos?sslmode=require

# Secret de signature des tokens de session
JWT_SECRET=change-me-long-random-string

# Origine du front autorisée en CORS (URL Cloudflare Pages en prod)
FRONTEND_URL=http://localhost:5173
PORT=3000

# Compte de test local, créé par « npm run seed:test » (refusé hors localhost)
TEST_USERNAME=test
TEST_PASSWORD=change-me
